{
  "expo": {
    "name": "SiteProof",
    "slug": "siteproof-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "siteproof",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.alicanyayl.siteproof",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
