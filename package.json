{
  "name": "siteproof-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "lint": "eslint src __tests__ test-utils eslint.config.js --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:run": "jest --ci --runInBand",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm run doctor && pnpm export:android"
  },
  "dependencies": {
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg))"
    ]
  }
}
